# ========================================================
# SRR FILLING STATION - CLOUD CONFIGURATION (.env)
# ========================================================

# Option 1: Cloud PostgreSQL (Recommended - 100% Free at Neon.tech or Supabase)
# Provides isolated schema per filling station (station_<slug>) with 0 relation
DATABASE_URL=postgresql://neondb_owner:npg_examplepassword@ep-cool-lake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option 2: Cloud MongoDB Atlas (100% Free M0 Cluster)
# Creates a dedicated database per filling station (station_<slug>)
# MONGODB_URI=mongodb+srv://admin:examplepassword@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority

# Optional: Server Port (Render and Cloud hosts set this automatically)
PORT=5000
NODE_ENV=production
